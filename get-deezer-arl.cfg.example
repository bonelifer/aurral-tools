# Settings for get-deezer-arl.py. Copy to get-deezer-arl.cfg next to the
# script and run: chmod 600 get-deezer-arl.cfg
# Command-line options override these values.

[deezer]
# Deezer account the script signs in with. Leave both empty to sign in
# by hand in the browser window instead.
email =

# Deezer password. The script refuses to read it unless only you can
# read this file (chmod 600).
password =

[deemix]
# deemix server to send the ARL to. Leave empty to print the ARL instead.
url = http://localhost:6595

[browser]
# Seconds to wait for the sign-in to finish before giving up.
timeout = 300
